# PFM — Selfhost mode
#
# 1. cp .env.selfhost.example .env
# 2. Fill in the required values below
# 3. docker compose up -d
# 4. ./kontaro.sh create-user you@example.com yourpassword

# ── Port ──────────────────────────────────────────────────────────────────────
# If you change this, update the port in SUPABASE_URL below to match.
APP_PORT=8181
# MCP server port — default 3100. Uncomment to change if the port is taken.
# MCP_PORT=3100

# Docker Compose profile — makes all docker compose commands (up, down, logs)
# include the selfhost services without passing --profile every time.
COMPOSE_PROFILES=selfhost

# ── URL ───────────────────────────────────────────────────────────────────────
# Public address where the browser reaches this app. Port must match APP_PORT.
# For remote access (LAN IP, a VPN such as Tailscale, or a custom domain),
# replace localhost with your hostname or IP.
SUPABASE_URL=http://localhost:8181

# ── Secrets ───────────────────────────────────────────────────────────────────
# Shared JWT secret — GoTrue signs tokens with it; PostgREST and the importer
# verify them. All three must use the same value.
# Generate: openssl rand -hex 32
SUPABASE_JWT_SECRET=

# DB password — used for Postgres, GoTrue, PostgREST, and the importer.
# Generate: openssl rand -hex 16
DB_PASSWORD=

# Encryption key for Pluggy credentials and PDF passwords stored in the DB.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠ Back this up separately from the database. Losing it is unrecoverable.
SECRETS_ENC_KEY=

# ── Migrate DB URL ────────────────────────────────────────────────────────────
# Replace <password> with your DB_PASSWORD value.
SUPABASE_DB_URL=postgresql://postgres:<password>@127.0.0.1:54332/postgres

# If 54332 is taken (e.g. a local `supabase start` stack is running), change
# BOTH this port and DB_PORT below to the same free port.
DB_PORT=54332

# ── Signup control ────────────────────────────────────────────────────────────
# true  = closed — create accounts via: ./kontaro.sh create-user <email> <password>
# false = anyone who can reach the app can sign up (the auth default-role
#   migration fills the role automatically; ./kontaro.sh set-role <email> is the
#   fallback for users created before that migration existed)
GOTRUE_DISABLE_SIGNUP=true

# ── Email / SMTP (optional) ──────────────────────────────────────────────────
# Without SMTP, use ./kontaro.sh reset-password to change passwords via CLI.
# With SMTP, users can request a password-reset link from the login page.
#
# GOTRUE_SMTP_HOST=smtp.mailgun.org
# GOTRUE_SMTP_PORT=587
# GOTRUE_SMTP_USER=
# GOTRUE_SMTP_PASS=
# GOTRUE_SMTP_ADMIN_EMAIL=noreply@yourdomain.com
# GOTRUE_SMTP_SENDER_NAME=Kontaro
# Set to false (when SMTP is set) to require email verification on new signups.
# GOTRUE_MAILER_AUTOCONFIRM=false

# ── Optional ──────────────────────────────────────────────────────────────────
# Hide Google/GitHub buttons. Keep false unless you configure an OAuth provider.
OAUTH_ENABLED=false

# Auto-login: skip the login screen and sign in automatically with these credentials.
# Useful for single-user self-hosted setups. Leave blank to show the login screen.
#
# WARNING: the password is served in cleartext to anyone who can reach the app.
# Runtime config goes out as a static, unauthenticated GET /config.js, so
# `curl http://your-host:8181/config.js` returns AUTO_LOGIN_PASSWORD verbatim.
# Only set these on a network where every client is already trusted.
# AUTO_LOGIN_EMAIL=you@example.com
# AUTO_LOGIN_PASSWORD=yourpassword

# Open Exchange Rates API key for USD/EUR → BRL conversion (C6 Global statements).
OPENEXCHANGERATES_APP_ID=

# Automatic daily Pluggy sync — up to 3 comma-separated HH:MM slots, in the
# importer container's clock (UTC by default). Each connector has its own
# timezone, set in the UI, used only to interpret Pluggy statement dates —
# unrelated to when the sync itself runs. Leave SYNC_TIMES empty to disable
# the scheduler and rely on manual "Sync now" or your own cron.
SYNC_TIMES=08:00,13:00,18:00
