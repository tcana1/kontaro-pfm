# PFM — Cloud mode (Supabase hosted)
# For selfhost mode (all services local), use .env.selfhost.example instead.
#
# 1. cp .env.example .env
# 2. Fill in the values below
# 3. docker compose up -d

# ── Port ──────────────────────────────────────────────────────────────────────
APP_PORT=8181
# MCP server port — default 3100. Uncomment to change if the port is taken.
# MCP_PORT=3100

# ── Services to run ─────────────────────────────────────────────────────────────
# The MCP server (AI-assistant integration) is opt-in via the "mcp" Compose
# profile. Keep it here to run it; remove "mcp" to start the stack without the
# AI server (app + importer still work normally).
COMPOSE_PROFILES=mcp

# ── Supabase Cloud ────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://<project>.supabase.co
# The new publishable key (sb_publishable_...) or the legacy anon key — both work.
SUPABASE_ANON_KEY=

# ── Auth / JWT ──────────────────────────────────────────────────────────────────
# Cloud supports TWO signing schemes. Kontaro accepts either — pick the one your
# Supabase project uses.
#
# NEW — JWT Signing Keys (asymmetric ES256/RS256), recommended for new projects:
#   • The importer verifies user tokens automatically via the project's JWKS
#     (<SUPABASE_URL>/auth/v1/.well-known/jwks.json) — no secret needed.
#   • The MCP mints its own tokens, so it needs the private signing key below.
#     Generate: `supabase gen signing-key --algorithm ES256`, import the JWK in
#     the dashboard (Project Settings → JWT Signing Keys), and paste the same JWK
#     JSON here. The kid is read from the JWK; set SUPABASE_JWT_KID only to
#     override it (or when supplying a PEM key instead of a JWK).
#   (If you don't run the MCP — "mcp" removed from COMPOSE_PROFILES — you can
#   leave both of these blank; the importer still verifies via JWKS.)
SUPABASE_JWT_SIGNING_KEY=
# SUPABASE_JWT_KID=
#
# LEGACY — HS256 shared secret (Project Settings → API → JWT Secret). Still valid
# until Supabase retires it. Uncomment and fill this if your project has NOT
# migrated to JWT Signing Keys; then leave SUPABASE_JWT_SIGNING_KEY blank. The
# importer verifies with it (HS256) and the MCP signs with it.
# SUPABASE_JWT_SECRET=

# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠ Back this up separately from the database. Losing it is unrecoverable.
SECRETS_ENC_KEY=

# ── DB connection ────────────────────────────────────────────────────────────
# Project Settings → Database → Connection Pooling → Session pooler.
# Used by the importer, mcp, and (as a fallback) the one-off migrate step.
# Must use the pooler, not the direct host (db.<project>.supabase.co) — the
# direct host is IPv6-only unless you pay for the IPv4 add-on, and the
# importer/mcp containers don't have an IPv6 route.
# ⚠ Keep this secret — full write access to your database.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Optional ──────────────────────────────────────────────────────────────────
OPENEXCHANGERATES_APP_ID=

# Auto-login: skip the login screen and sign in automatically with these credentials.
#
# WARNING: the password is served in cleartext to anyone who can reach the app.
# Runtime config goes out as a static, unauthenticated GET /config.js, so
# `curl http://your-host:8181/config.js` returns AUTO_LOGIN_PASSWORD verbatim.
# Only set these on a network where every client is already trusted.
# AUTO_LOGIN_EMAIL=you@example.com
# AUTO_LOGIN_PASSWORD=yourpassword

# Automatic daily Pluggy sync — up to 3 comma-separated HH:MM slots, in the
# importer container's clock (UTC by default). Each connector has its own
# timezone, set in the UI, used only to interpret Pluggy statement dates —
# unrelated to when the sync itself runs. Leave SYNC_TIMES empty to disable
# the scheduler and rely on manual "Sync now" or your own cron.
SYNC_TIMES=08:00,13:00,18:00
