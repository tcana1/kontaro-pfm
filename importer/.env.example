# ── DB connection ─────────────────────────────────────────────────────────────
# Full connection string. Examples:
# Selfhost (docker compose --profile selfhost):
#   DATABASE_URL=postgresql://postgres:<same as POSTGRES_PASSWORD in root .env>@db:5432/postgres
#
# Dev (supabase start / local Supabase CLI) — can't use 127.0.0.1 from inside the container:
#   DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54332/postgres
#
# Cloud: use the Session pooler connection string from Supabase (Project Settings →
# Database → Connection Pooling). Use a dedicated non-superuser role in production.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54332/postgres

# Supabase project URL — injected automatically from the root .env via docker-compose;
# set here only for standalone use.
# Selfhost: SUPABASE_URL=http://localhost:8181 (public URL; HS256 validation uses
# SUPABASE_JWT_SECRET directly — this value is only a fallback for future asymmetric keys).
# SUPABASE_URL=http://localhost:8181

# JWT secret for HS256 verification. Must match SUPABASE_JWT_SECRET in the root .env.
# Selfhost: copy the SUPABASE_JWT_SECRET value here.
# Dev (local Supabase CLI): super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_SECRET=

# Encryption key for secrets stored in the DB (Pluggy credentials, PDF passwords, etc.)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠ Back this up separately from the database. Losing it makes all encrypted secrets irrecoverable.
SECRETS_ENC_KEY=

LOG_LEVEL=INFO
ENVIRONMENT=dev

# Optional: Open Exchange Rates app ID for currency conversion in C6 Global (USD/EUR) statements.
# Without this, foreign-currency amounts are imported as-is without BRL conversion.
# Sign up free at https://openexchangerates.org
OPENEXCHANGERATES_APP_ID=

# Comma-separated list of allowed CORS origins for the frontend.
# Example: CORS_ORIGINS=https://pfm.example.com,http://localhost:8181
CORS_ORIGINS=http://localhost:8181

# Automatic daily Pluggy sync — up to 3 comma-separated HH:MM slots, in the
# importer container's clock (UTC by default). Each connector has its own
# timezone, set in the UI, used only to interpret Pluggy statement dates —
# unrelated to when the sync itself runs. Leave SYNC_TIMES empty to disable
# the scheduler and rely on manual "Sync now" or your own cron.
SYNC_TIMES=08:00,13:00,18:00
